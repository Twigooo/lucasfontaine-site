---
import '../styles/global.css';
import Navbar from '../components/Navbar.tsx';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "Lucas Fontaine — IA Locale & Développement Web" 
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600&family=Lora:ital,wght@0,500;1,500;1,600&family=Outfit:wght@700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-ivory text-ink antialiased selection:bg-emerald selection:text-ivory">
    <!-- Barre de navigation commune à toutes les pages -->
    <Navbar client:load currentPath={Astro.url.pathname} />

    <slot />
  </body>
</html>